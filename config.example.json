{
  "_说明": "复制为 config.json 后按需修改。全部字段都可省略 —— 省略即用这里的默认值。首次启动若没有 config.json，会自动创建一份并生成随机 apiKey。",

  "listen": "127.0.0.1:8787",
  "apiKey": "",

  "_upstream": "delegate = 委托真实 opencode（推荐，唯一能过免费层凭据门禁的通道）；direct = 直连 Zen 纯 HTTP（过不了门禁，仅作对照）",
  "upstream": "delegate",

  "defaultModel": "mimo-v2.6-flash-free",

  "_modelDenylist": "上游永久不可用 / 被全局禁用的模型 id",
  "modelDenylist": [
    "big-pickle",
    "exo-free",
    "jev-1.13-free",
    "ling-3.0-flash-fin-free",
    "ling-3.1-flash-free",
    "muse-spark-1.2-contributor-free",
    "muse-spark-1.3-contributor-free"
  ],
  "modelAllowlist": [],

  "requestTimeoutMs": 300000,
  "firstEventTimeoutMs": 60000,
  "refreshSeconds": 300,

  "probe": {
    "enabled": true,
    "intervalSeconds": 3600,
    "concurrency": 2,
    "missThreshold": 3
  },

  "retry": {
    "maxAttempts": 4,
    "baseDelayMs": 800
  },

  "limits": {
    "globalConcurrency": 8,
    "perModelConcurrency": 2,
    "maxQueue": 8,
    "maxWaitMs": 30000
  },

  "observability": {
    "logCapacity": 500,
    "latencyWindow": 500
  }
}
